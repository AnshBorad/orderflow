# Copy to .env and fill with your OWN values
DATABASE_URL="postgresql://user:password@localhost:5432/orderflow?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="change-me-64-hex-chars"
ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_SECRET="change-me-too-64-hex-chars"
REFRESH_TOKEN_EXPIRY=7d
# Razorpay TEST keys from dashboard.razorpay.com (Settings > API Keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxx"
RAZORPAY_KEY_SECRET="change-me"
RAZORPAY_WEBHOOK_SECRET="change-me"